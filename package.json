{
  "name": "@biqpod/snapbuy",
  "private": true,
  "version": "0.2.1",
  "scripts": {
    "dev": "vite",
    "mobile": "vite --mode mobile",
    "compile": "tsc --noEmit",
    "build": "tsc && vite build",
    "build.mobile": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --mode mobile",
    "desktop": "vite --mode electron",
    "electron.build": "vite build --mode electron",
    "electron.linux.build": "vite build --mode electron && electron-builder --linux --x64",
    "electron.windows.build": "vite build --mode electron && electron-builder --win --x64",
    "electron.macos.build": "vite build --mode electron && electron-builder --mac --x64",
    "electron.build.all": "vite build --mode electron && electron-builder",
    "electron.linux": "electron-builder --linux --x64",
    "electron.windows": "electron-builder --win --x64",
    "electron.macos": "electron-builder --mac --x64",
    "electron": "electron-builder",
    "android.dev": "cross-env NODE_ENV=development npx cap sync android && npx cap open android",
    "android.open": "npx cap open android",
    "android.build": "npm run build.mobile && cross-env NODE_ENV=production npx cap sync android && cd ./android && .\\gradlew assembleRelease",
    "android.sync": "npx cap sync android",
    "ios.dev": "cross-env NODE_ENV=development npx cap sync ios && npx cap run ios",
    "ios.open": "npx cap open ios",
    "ios.build": "npm run build.mobile && cross-env NODE_ENV=production npx cap sync ios && cd ./ios && echo 'ios command'",
    "ios.sync": "npx cap sync ios",
    "preview": "vite preview",
    "lint": "eslint"
  },
  "dependencies": {
    "@babylonjs/core": "^6.49.0",
    "@babylonjs/loaders": "^6.49.0",
    "@babylonjs/materials": "^6.49.0",
    "@biqpod/app": "^0.4.2",
